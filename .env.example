# ── Flask ─────────────────────────────────────────
FLASK_SECRET_KEY="replace-with-a-long-random-secret"
FLASK_ENV=development
FLASK_DEBUG=1

# ── Database (MySQL) ─────────────────────────────
DATABASE_URL="mysql+pymysql://user:password@localhost/prepai_db?charset=utf8mb4"

# ── AI (Google Gemini) ───────────────────────────
AI_API_KEY="replace-with-your-google-gemini-api-key"
AI_MODEL="gemini-3.1-flash-lite"
