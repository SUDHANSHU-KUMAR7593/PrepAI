SECRET_KEY="replace-with-a-long-random-secret"
AI_API_KEY="replace-with-your-google-gemini-api-key"
AI_MODEL="gemini-3.6-flash"

# MySQL connection. Use either DATABASE_URL or the individual MYSQL_* values.
DATABASE_URL="mysql://user:password@localhost:3306/prepai"
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="prepai_user"
MYSQL_PASSWORD="replace-with-your-mysql-password"
MYSQL_DATABASE="prepai"

# Optional: path to a CA certificate for hosted MySQL providers that require TLS.
# MYSQL_SSL_CA="/path/to/ca.pem"

# Optional: source SQLite file for one-time migration.
SQLITE_DATABASE="prepai.sqlite3"
